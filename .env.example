# Groq AI Keys and Models
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_TEXT=openai/gpt-oss-120b
GROQ_MODEL_TEXT_FALLBACK=openai/gpt-oss-20b
GROQ_MODEL_VISION=qwen/qwen3.8-27b
GROQ_MODEL_STT=whisper-large-v3
GROQ_MODEL_GUARD=meta-llama/llama-prompt-guard-2-86m

# Database (leave blank for zero-config in-memory single-node replica set in development)
MONGODB_URI=

# Authentication and Security (generated automatically by npm run setup)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Web Push VAPID Keys (generated automatically by npm run setup)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Server & Client Networking
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
RP_ID=localhost
NODE_ENV=development
DEV_FIXED_OTP=123456
